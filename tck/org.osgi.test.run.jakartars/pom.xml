	<build>
		<plugins>
			<plugin>
				<groupId>biz.aQute.bnd</groupId>
				<artifactId>bnd-resolver-maven-plugin</artifactId>
				<!-- The parent already binds resolve to pre-integration-test
				     (execution "resolve-test") with this same configuration. -->
				<configuration>
					<failOnChanges>false</failOnChanges>
					<writeOnChanges>true</writeOnChanges>
					<bndruns>
						<bndrun>tck.bndrun</bndrun>
					</bndruns>
				</configuration>
			</plugin>
			<plugin>
				<groupId>biz.aQute.bnd</groupId>
				<artifactId>bnd-testing-maven-plugin</artifactId>
				<!-- Deliberately NOT ${bnd.version}: with the 7.2.3 launcher and
				     the 6.4.0 classic tester the junit-platform suites hang
				     before writing a single result. Only the launch suites,
				     which use the classic tester, come up. -->
				<version>${bnd.old.version}</version>
			</plugin>
			<!-- Renders the bnd-testing JUnit XML into a readable HTML report:
			     mvn surefire-report:report-only -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-report-plugin</artifactId>
				<version>3.5.2</version>
				<configuration>
					<reportsDirectories>
						<reportsDirectory>${project.build.directory}/test-reports/tck</reportsDirectory>
					</reportsDirectories>
				</configuration>
			</plugin>
		</plugins>
	</build>
